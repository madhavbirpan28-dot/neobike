{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEO Firestore Schema",
  "version": "1.0.0",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "path": "users/{userId}",
      "description": "Biker profiles with vehicle and pace preferences",
      "fields": {
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "avatarEmoji": { "type": "string", "maxLength": 10 },
        "bio": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "motorcycle": { "type": "string", "maxLength": 100 },
        "experienceLevel": { "type": "string", "maxLength": 50 },
        "pacePreference": { "type": "string", "maxLength": 50 },
        "isContactVerified": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "name", "city", "motorcycle", "createdAt"]
    },
    "Ride": {
      "collection": "rides",
      "path": "rides/{rideId}",
      "description": "Motorcycle touring itineraries and shared trips",
      "fields": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "origin": { "type": "string", "maxLength": 100 },
        "destination": { "type": "string", "maxLength": 100 },
        "departureDate": { "type": "string", "maxLength": 20 },
        "departureTime": { "type": "string", "maxLength": 20 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 50 },
        "confirmedRiderIds": { "type": "array", "items": { "type": "string" } },
        "organizerId": { "type": "string" },
        "organizerName": { "type": "string" },
        "organizerAvatar": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "CANCELLED", "COMPLETED"] },
        "tripType": { "type": "string" },
        "pace": { "type": "string" },
        "meetingPoint": { "type": "string" },
        "distanceKm": { "type": "integer" },
        "durationHours": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "origin", "destination", "departureDate", "capacity", "organizerId", "status", "createdAt"]
    }
  }
}
